  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "Bevor es losgeht:\nDie n\xE4chsten Fragen gehen darum, wie du die App
    gerade fandest und wie du dich dabei gef\xFChlt hast. Es gibt keine richtigen
    oder falschen Antworten. Antworte einfach ehrlich und so, wie es f\xFCr dich
    war.\n\nBei jeder Frage kannst du eine Antwort auf einer Skala von 1 bis 5 ausw\xE4hlen:\n1
    = stimmt \xFCberhaupt nicht\n2 = stimmt eher nicht\n3 = teils/teils\n4 = stimmt
    eher\n5 = stimmt v\xF6llig\n\nW\xE4hle immer die Zahl aus, die am besten zu deiner
    Meinung passt."
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 8f586378b4e144a9851e7b34d9b748ee, type: 2}
