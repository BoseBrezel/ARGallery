  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "Marie Curie (1867\u20131934) war eine bekannte Physikerin und Chemikerin.
    \n\nSie wies Radioaktivit\xE4t nach und entdeckte die beiden chemischen Elemente
    Polonium und Radium.\n\nSie war die erste Frau, die in Europa eine Professur
    innehatte, und die erste Frau, die 1903 den Nobelpreis f\xFCr Physik und 1911
    einen weiteren Nobelpreis f\xFCr Chemie erhielt. \n\nBis heute hat nur eine weitere
    Person, Linus Pauling, zwei Nobelpreise in zwei verschiedenen Disziplinen erhalten.
    Im Ersten Weltkrieg rettete sie mit ihrem\r\nmobilen R\xF6ntgenger\xE4t vielen
    Soldaten das Leben"
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 53b7dc9738695844dab3661661ffa824, type: 2}
