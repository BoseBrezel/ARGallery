  m_Name: 
  m_EditorClassIdentifier: Unity.TextMeshPro::TMPro.TextMeshProUGUI
  m_Material: {fileID: 0}
  m_Color: {r: 1, g: 1, b: 1, a: 1}
  m_RaycastTarget: 1
  m_RaycastPadding: {x: 0, y: 0, z: 0, w: 0}
  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "Der Jupiter ist mit einem \xC4quatordurchmesser 143.000 km der gr\xF6\xDFte
    und auch die schwerste Planet des Sonnensystems.\r\n\nEr ist der f\xFCnfte Planet
    in unserem Sonnensystem und ein Gasriese.\r\n\nEin Tag auf dem Jupiter dauert
    10 Erdstunden und ein Jupiterjahr entspricht 12 Erdjahren. \r\n"
