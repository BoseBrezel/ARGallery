  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "Die Internationale Raumstation ISS wurde von 1994 bis 1998 aufgebaut und
    wird seitdem durch eine internationale Kooperation von 16 Staaten betrieben sowie
    weiterentwickelt.\r\n\nSeit November 2000 ist die ISS dauerhaft von Menschen
    bewohnt. Sie ist die gr\xF6\xDFte und langlebigste Raumstation der Menschheit.
    \n\nDie ISS umkreist die Erde in etwa 400 Kilometern H\xF6he und ben\xF6tigt
    f\xFCr einen Umlauf ungef\xE4hr 93 Minuten. \n\nMit ihren Solarmodulen hat sie
    eine Ausdehnung von etwa 110 \xD7 50 \xD7 77 Metern und ist damit ungef\xE4hr
    so gro\xDF wie ein Fu\xDFballfeld."
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 53b7dc9738695844dab3661661ffa824, type: 2}
