  m_Name: 
  m_EditorClassIdentifier: Unity.TextMeshPro::TMPro.TextMeshProUGUI
  m_Material: {fileID: 0}
  m_Color: {r: 1, g: 1, b: 1, a: 1}
  m_RaycastTarget: 1
  m_RaycastPadding: {x: 0, y: 0, z: 0, w: 0}
  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "Mars Express startete im Juni 2003 und erreichte den Mars am 25. Dezember
    2003. Urspr\xFCnglich war die Mission ab Juni 2004 auf ein Marsjahr ausgelegt,
    was etwa 23 Monaten auf der Erde entspricht. \n\nInzwischen wurde die Mission
    mehrfach verl\xE4ngert und soll noch bis mindestens Ende 2026 laufen. Zu den
    Zielen der Mission geh\xF6ren die vollst\xE4ndige Kartografierung des roten Planeten
    sowie die Erforschung der Marsatmosph\xE4re, seiner Oberfl\xE4che und der obersten
    Bodenschicht. An Bord befindet sich unter anderem die High Resolution Stereo
    Camera (HRSC), die am Deutschen Zentrum f\xFCr Luft- und Raumfahrt (DLR) in Berlin-Adlershof
    entwickelt und gebaut wurde. \n\nDie HRSC liefert Bilder mit einer Aufl\xF6sung
    von 10 Metern, aus denen eine dreidimensionale Karte des Mars erstellt werden
    kann. Neben dem Orbiter war auch das Landeger\xE4t Beagle 2 an Bord, welches
    am 19. Dezember 2003 abgekoppelt wurde."
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 53b7dc9738695844dab3661661ffa824, type: 2}
  m_sharedMaterial: {fileID: 7056235866793819528, guid: 53b7dc9738695844dab3661661ffa824, type: 2}
