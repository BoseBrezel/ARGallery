  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "La Jamais Contente war ein elektrisch betriebenes Fahrzeug, das 1899 als
    erstes Stra\xDFenfahrzeug die Geschwindigkeitsmarke von 100 km/h durchbrach.
    \n\nDer belgische Ingenieur und Rennfahrer Camille Jenatzy konstruierte und fuhr
    den Wagen in Ach\xE8res bei Paris. Zuvor hatte Janatzy benzinbetriebene Rennwagen
    gebaut, mit denen er jedoch nicht die gew\xFCnschte Geschwindigkeit erreichte.
    \n\nErst die Kombination aus Elektroantrieb und einer besonders aerodynamischen
    Karosserie erm\xF6glichte den Rekord.\r\n"
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 53b7dc9738695844dab3661661ffa824, type: 2}
