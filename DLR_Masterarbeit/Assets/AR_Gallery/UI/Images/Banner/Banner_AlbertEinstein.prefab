  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "Albert Einstein (1879\u20131955) war ein schweizerisch-US-amerikanischer
    Physiker. \nEr ist der Entdecker der Relativit\xE4tstheorie und ber\xFChmt f\xFCr
    die Formel E = mc\xB2, also Energie (E) ist gleich der Masse (m) mal Lichtgeschwindigkeit
    hoch zwei (\xB2), die er erstmals 1907 beschrieb. \n\n\nF\xFCr die Entdeckung
    des photoelektrischen Effekts erhielt Albert Einstein 1921 den Nobelpreis. Er
    nutzte seine au\xDFerordentliche Bekanntheit auch au\xDFerhalb der Wissenschaft,
    zum Beispiel im Rahmen seines Engagements f\xFCr V\xF6lkerverst\xE4ndigung, Frieden
    und Abr\xFCstung."
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 53b7dc9738695844dab3661661ffa824, type: 2}
