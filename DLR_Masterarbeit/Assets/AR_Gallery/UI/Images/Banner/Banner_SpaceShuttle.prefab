  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "Vom ersten Start am 12. April 1981 bis zur letzten Landung am 21. Juli
    2011 flog die Space-Shuttle Flotte der NASA 135 Missionen und half unter anderem
    beim Bau der Internationalen Raumstation\r\nISS. \n\nZun\xE4chst wurde das Test-Shuttle
    Enterprise gebaut, um die Flugeigenschaften in der\r\nErdatmosph\xE4re zu testen.
    Sp\xE4ter wurden f\xFCnf Orbiter f\xFCr den Einsatz im Weltraum gebaut: Columbia,
    Challenger, Discovery, Atlantis und Endeavour. \n\nDie Raumf\xE4hre konnte bis
    zu acht Astronauten und gleichzeitig 24,5 Tonnen Nutzlast in eine niedrige Erdumlaufbahn,
    zum Beispiel auf H\xF6he der ISS, bringen."
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 53b7dc9738695844dab3661661ffa824, type: 2}
