  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "Sir Isaac Newton (1643\u20131726) war ein britischer Physiker, Astronom
    und Mathematiker. Er entwickelte die Gravitationslehre, indem er bewies, dass
    sich K\xF6rper gegenseitig anziehen und mit ihrer Schwerkraft aufeinander einwirken.
    \n\nAu\xDFerdem wies er die Zusammensetzung von Licht nach und baute im Jahr
    1672 das erste Spiegelteleskop. \n\nNewton ist einer der bedeutendsten Wissenschaftler
    aller Zeiten. Seine Berechnungen und Formeln werden noch heute verwendet, zum
    Beispiel wenn eine Rakete startet.\r\n\nEin Apfel, der von einem Baum auf Isaac
    Newtons Kopf fiel, soll ein Schl\xFCsselerlebnis f\xFCr die Entdeckung der Gravitation
    gewesen sein."
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 53b7dc9738695844dab3661661ffa824, type: 2}
  m_sharedMaterial: {fileID: 7056235866793819528, guid: 53b7dc9738695844dab3661661ffa824, type: 2}
