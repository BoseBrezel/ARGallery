  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "Die Galileischen Monde sind die vier gr\xF6\xDFten Monde des Jupiters
    und wurden nach ihrem Entdecker Galileo Galilei benannt. \n\nDie Galileischen
    Monde hei\xDFen Io, Europa, Ganymed und Kallisto. 2023 startete die europ\xE4ische
    Mission JUICE (Jupiter Icy Moons Explorer) zur Erkundung von Europa, Ganymed
    und Kallisto. \n\nDie Sonde soll 2031 am Jupiter ankommen und unter anderem untersuchen,
    ob unter den dicken Eiskrusten der Monde die Voraussetzungen f\xFCr Leben gegeben
    sein k\xF6nnten."
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 53b7dc9738695844dab3661661ffa824, type: 2}
  m_sharedMaterial: {fileID: 7056235866793819528, guid: 53b7dc9738695844dab3661661ffa824, type: 2}
