  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "Lise Meitner (1878\u20131968) war eine \xF6sterreichische Kernphysikerin
    und Pionierin der Radiochemie, die zu den bedeutendsten Personen in den Naturwissenschaften
    des 20. Jahrhunderts z\xE4hlt. \n\nSie erforschte gemeinsam mit dem Chemiker
    Otto Hahn Radioaktivit\xE4t und radioaktive Isotope. \n\nIm Jahr 1926 wurde sie
    die erste Professorin f\xFCr Physik in Deutschland. Lise Meitner wurde jahrzehntelang
    immer wieder f\xFCr den Nobelpreis f\xFCr Chemie und den Nobelpreis f\xFCr Physik
    nominiert, erhielt aber letztlich keinen."
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 53b7dc9738695844dab3661661ffa824, type: 2}
  m_sharedMaterial: {fileID: 7056235866793819528, guid: 53b7dc9738695844dab3661661ffa824, type: 2}
